---
interface ProjectEntry {
  data: {
    name: string;
    tagline: string;
    url: string;
    repo: string;
    tags: string[];
    short: string;
  };
}

interface Props {
  entries: ProjectEntry[];
}

const { entries } = Astro.props;
---

<section id="projects" class="py-24 md:py-32 px-8 bg-[var(--color-bg-card)]">
  <div class="max-w-4xl mx-auto">
    <h2 class="section-heading font-heading text-3xl md:text-4xl font-bold mb-16 text-[var(--color-accent)]" data-animate="fade-up">
      Projects
    </h2>

    <div
      class="p-10 rounded-xl border border-dashed border-[var(--color-border)] bg-[var(--color-bg)] text-center"
      data-animate="fade-up"
    >
      <p class="text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Coming soon &mdash; I got a sweet jumbotron planned, just imagine it for now.
      </p>
    </div>
  </div>
</section>
